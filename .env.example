# Copy to .env (gitignored), or just run `make secrets` and one is generated with random keys.
# Everyone deploying to the SAME cluster must use the same LIFEBOAT_HMAC_SECRET: share .env privately.
LIFEBOAT_HMAC_SECRET=replace-with-a-long-random-string
# minio = laptop/k3d (MinIO in the cluster); aws = real S3 bucket via the EC2 instance profile
S3_MODE=minio
LIFEBOAT_S3_BUCKET=lifeboat-checkpoints
MINIO_ROOT_USER=lifeboat
MINIO_ROOT_PASSWORD=replace-with-a-long-random-string
AWS_DEFAULT_REGION=us-east-1
